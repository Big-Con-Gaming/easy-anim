{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Animation Name:",
    "type": "text"
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "name",
      "label": {
        "text": "That Name is Taken. Try Again:"
      },
      "label_visible": true
    }
  ],
  "can_close_with_escape": true,
  "exit_action": {
    "label": "Cancel",
    "width": 40
  },
  "actions": [
    {
      "label": "Submit",
      "width": 40,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function easy-anim:menu/set_name {name:$(name)}"
      }
    }
  ]
}