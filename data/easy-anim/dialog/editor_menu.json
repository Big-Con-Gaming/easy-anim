{
  "type": "minecraft:multi_action",
  "title": "Editor Menu",
  "can_close_with_escape": true,
  "exit_action": {
    "label": "Cancel"
  },
  "actions": [
    {
      "label": "Save Current Frame",
      "tooltip": "You must be within the bounding region of a frame for this to work.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/save_current_frame"
      }
    },
    {
      "label": "Remove Current Frame",
      "tooltip": "You must be within the bounding region of a frame for this to work.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/clear_current_frame"
      }
    },
    {
      "label": "Exit Editor",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/exit"
      }
    }
  ]
}