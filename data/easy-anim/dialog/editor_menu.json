{
  "type": "minecraft:multi_action",
  "title": "Editor Menu",
  "can_close_with_escape": true,
  "exit_action": {
    "label": "❌ Close"
  },
  "actions": [
    {
      "label": "✔ Modify Selection",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:menu/display_modify_select_dialog"
      }
    },
    {
      "label": "💾 Save Frames",
      "tooltip": "Operates on all selected frames.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/operation_on_selected_frames {mode: save}"
      }
    },
    {
      "label": "♻ Reload Frames",
      "tooltip": "Operates on all selected frames.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/operation_on_selected_frames {mode: load}"
      }
    },
    {
      "label": "🗑 Remove Frames",
      "tooltip": "Operates on all selected frames.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/operation_on_selected_frames {mode: clear}"
      }
    },
    {
      "label": "➕ Add New Frame",
      "tooltip": "Adds a frame inserted at the frames selected, and defaults to the end of the animation if none are selected.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/operation_on_selected_frames {mode: addBase}"
      }
    },
    {
      "label": "📸 Save Camera for Frames",
      "tooltip": "Operates on all selected frames, saves relative to your closest selected frame.",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "easy-anim:camera_info_frame"
      }
    },
    {
      "label": "🎞 Load Camera for Frames",
      "tooltip": "Operates on all selected frames, shows you a preview of those frames with their durations.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/operation_on_selected_frames {mode: loadCamera}"
      }
    },
    {
      "label": "👁 Highlight Cam For Frames",
      "tooltip": "Operates on all selected frames, shows where their cameras are located.",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/operation_on_selected_frames {mode: highlightCamera}"
      }
    },
    {
      "label": "⌛ Set Frames Duration",
      "tooltip": "Operates on all selected frames.",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "easy-anim:frame_duration"
      }
    },
    {
      "label": "🚶 Exit Editor",
      "action": {
        "type": "minecraft:run_command",
        "command": "function easy-anim:animation/exit with entity @s"
      }
    }
  ]
}